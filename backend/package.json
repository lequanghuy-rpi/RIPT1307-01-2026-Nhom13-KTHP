{
  "name": "esports-tournament-backend",
  "version": "1.0.0",
  "description": "Esports Tournament Platform - Backend API (Node.js + Express + TypeScript + Prisma + SQL Server)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec ts-node src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "setup": "prisma generate && prisma db push && ts-node prisma/seed.ts",
    "dev:fresh": "npm run setup && npm run dev",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:prod": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "ts-node prisma/seed.ts",
    "prisma:push": "prisma db push",
    "prisma:reset": "prisma migrate reset"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "keywords": [
    "esports",
    "tournament",
    "nodejs",
    "express",
    "prisma",
    "sqlserver"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.9.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dayjs": "^1.11.21",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "nodemailer": "^6.10.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.9",
    "@types/node": "^25.6.0",
    "@types/nodemailer": "^6.4.17",
    "nodemon": "^3.1.14",
    "prisma": "^6.9.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
